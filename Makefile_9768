CC = gcc
CFLAGS = -Wall -Wextra -pthread

SERVER = server_9768
CLIENT = client_9768

SERVER_SRC = server_9768.c
CLIENT_SRC = client_9768.c

all: $(SERVER) $(CLIENT)

$(SERVER): $(SERVER_SRC)
	$(CC) $(CFLAGS) $(SERVER_SRC) -o $(SERVER)

$(CLIENT): $(CLIENT_SRC)
	$(CC) $(CFLAGS) $(CLIENT_SRC) -o $(CLIENT)

clean:
	rm -f $(SERVER) $(CLIENT)

.PHONY: all clean
